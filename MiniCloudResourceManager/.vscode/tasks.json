{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build engine (g++)",
      "type": "shell",
      "command": "g++",
      "args": ["-std=c++17", "-Wall", "-Wextra", "-pedantic", "-O2", "-pthread", "-Iinclude",
               "src/banker.cpp", "src/cpu_scheduler.cpp", "src/engine_api.cpp", "src/job.cpp", "src/json.cpp",
               "src/memory_manager.cpp", "src/ranking.cpp", "src/report.cpp", "src/resource_manager.cpp",
               "src/scheduler.cpp", "src/server.cpp", "src/simulation.cpp", "src/sync_demo.cpp", "src/workload.cpp",
               "src/engine_main.cpp", "-o", "build/mcrm_engine"],
      "windows": { "args": ["-std=c++17", "-Wall", "-Wextra", "-pedantic", "-O2", "-pthread", "-Iinclude",
               "src/banker.cpp", "src/cpu_scheduler.cpp", "src/engine_api.cpp", "src/job.cpp", "src/json.cpp",
               "src/memory_manager.cpp", "src/ranking.cpp", "src/report.cpp", "src/resource_manager.cpp",
               "src/scheduler.cpp", "src/server.cpp", "src/simulation.cpp", "src/sync_demo.cpp", "src/workload.cpp",
               "src/engine_main.cpp", "-o", "build/mcrm_engine.exe"] },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true },
      "dependsOn": "Make build folder"
    },
    {
      "label": "Build everything (Windows script)",
      "type": "shell",
      "command": "build_windows.bat",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run C++ tests (make)",
      "type": "shell",
      "command": "make test",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Python tests",
      "type": "shell",
      "command": "python -m unittest discover -s tests -t .",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Run migrations",
      "type": "shell",
      "command": "python backend/scripts/migrate.py",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Start backend (FastAPI)",
      "type": "shell",
      "command": "python -m uvicorn app.main:app --host 127.0.0.1 --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Make build folder",
      "type": "shell",
      "command": "mkdir",
      "args": ["-p", "build"],
      "options": { "cwd": "${workspaceFolder}" },
      "windows": { "command": "cmd", "args": ["/c", "if not exist build mkdir build"] }
    }
  ]
}
