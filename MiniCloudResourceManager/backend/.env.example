# Copy this file to backend/.env and fill in the values. backend/.env is git-ignored - NEVER commit it.
# Placeholders only: put your real password here on your own machine, not in chat, code or documentation.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mini_cloud_manager
DB_USER=cloud_app
DB_PASSWORD=change-me
DB_POOL_SIZE=5

# At least 32 random characters, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=480

# Optional: path to the compiled C++ engine. Default: <project>/build/mcrm_engine(.exe). Relative paths are
# relative to the project folder.
# ENGINE_PATH=build/mcrm_engine.exe
ENGINE_TIMEOUT_S=20
ENGINE_MAX_PARALLEL=4

# Comma-separated list of browser origins allowed to call the API from another origin. Empty = same-origin only.
CORS_ORIGINS=
SERVE_FRONTEND=true
APP_ENV=development
